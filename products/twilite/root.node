          "nodeId": "twilite-product-environment"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.environment"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:size;box-sizing:border-box;width:100%;height:100%;min-height:0;position:relative;overflow:hidden;background:radial-gradient(ellipse 75% 35% at 78% 14%,#35205d 0%,transparent 75%),radial-gradient(ellipse 65% 35% at 16% 92%,#202e59 0%,transparent 73%),#101225;color:#e8e0fc;font-family:system-ui,-apple-system,Segoe UI,sans-serif\">\n<div style=\"position:absolute;inset:0;pointer-events:none;opacity:.7;background-image:linear-gradient(#9f89d20e 1px,transparent 1px),linear-gradient(90deg,#9f89d20e 1px,transparent 1px);background-size:3.7cqw 3.7cqw\"></div>\n<div style=\"position:absolute;inset:1.6% 2.1%;border:.045cqw solid #8b76ad50;border-radius:.6cqw;pointer-events:none\"></div>\n<div style=\"position:absolute;top:2.65%;left:8.75%;right:7.6%;height:2.5%;display:flex;justify-content:space-between;align-items:center;border-bottom:.06cqw solid #9b87bc70\">\n<div style=\"display:flex;align-items:center;gap:1cqw\"><span style=\"width:1.15cqw;height:1.15cqw;display:inline-block;transform:rotate(45deg);background:#f8d14e\"></span><span style=\"font:850 1.22cqw/1.2 system-ui;letter-spacing:.16em;color:#ffdb69\">TWILITE</span><span style=\"font:650 .9cqw/1.2 system-ui;letter-spacing:.17em;color:#a8a0c4\">THE EDITOR / PRODUCT SHOWCASE</span></div>\n<div style=\"font:750 .93cqw/1.2 system-ui;letter-spacing:.12em;color:#aaa0c7\">BUILD · CONNECT · KEEP</div></div>\n<div style=\"position:absolute;top:6.3%;left:3.55%;width:.08cqw;height:64.2%;background:linear-gradient(#ffd35d,#8661c7 55%,#8661c700)\"></div>\n<div style=\"position:absolute;top:9%;left:3.1%;writing-mode:vertical-rl;transform:rotate(180deg);font:850 1.02cqw/1.1 system-ui;letter-spacing:.25em;color:#e8d4a0\">THE TWILITE ZONE · BRING YOUR OWN AI</div>\n<div style=\"position:absolute;left:7.65%;top:5.66%;width:70.3%;height:65.2%;border:.18cqw solid #e2d2ff;border-radius:.65cqw;box-shadow:0 0 0 .42cqw #312345,0 0 0 .5cqw #9c83be66,1cqw 1.3cqw 2.4cqw #0009;pointer-events:none\"></div>\n<div style=\"position:absolute;top:7.9%;left:79.6%;width:16.5%;display:flex;flex-direction:column;gap:2.4cqw\">\n<div style=\"padding-bottom:1.25cqw;border-bottom:.09cqw solid #f6cf6b\"><div style=\"font:900 1.07cqw system-ui;letter-spacing:.17em;color:#ffd25b\">WHY TWILITE?</div><div style=\"margin-top:.9cqw;font:520 2.75cqw/1.08 Georgia,serif;color:white\">An idea can become a place.</div></div>\n<div style=\"border-left:.14cqw solid #8873ba;padding-left:1.5cqw\"><div style=\"font:850 1cqw;letter-spacing:.14em;color:#f6d36f\">01 / PERSIST</div><div style=\"font:520 1.75cqw/1.28 Georgia,serif;margin-top:.6cqw\">Keep your work.</div><div style=\"font:400 1.12cqw/1.5 system-ui;color:#c1b6d7;margin-top:.5cqw\">The graph remains when the chat ends.</div></div>\n<div style=\"border-left:.14cqw solid #8873ba;padding-left:1.5cqw\"><div style=\"font:850 1cqw;letter-spacing:.14em;color:#f6d36f\">02 / EXPLORE</div><div style=\"font:520 1.75cqw/1.28 Georgia,serif;margin-top:.6cqw\">See the connections.</div><div style=\"font:400 1.12cqw/1.5 system-ui;color:#c1b6d7;margin-top:.5cqw\">Zoom from the big picture to one piece.</div></div>\n<div style=\"border-left:.14cqw solid #8873ba;padding-left:1.5cqw\"><div style=\"font:850 1cqw;letter-spacing:.14em;color:#f6d36f\">03 / COLLABORATE</div><div style=\"font:520 1.75cqw/1.28 Georgia,serif;margin-top:.6cqw\">Bring your own AI.</div><div style=\"font:400 1.12cqw/1.5 system-ui;color:#c1b6d7;margin-top:.5cqw\">A file both you and an agent can change.</div></div>\n<div style=\"border-top:.06cqw solid #8677a9;padding-top:1.5cqw\"><div style=\"font:850 .86cqw;letter-spacing:.15em;color:#aaa1c4\">NOT A STATIC MOCKUP</div><div style=\"margin-top:.5cqw;font:480 1.21cqw/1.47 system-ui;color:#d9cee9\">The doors below lead to real, separately authored Twilite graphs.</div></div></div>\n<div style=\"position:absolute;left:8.75%;right:8.3%;top:70.05%;height:2.0%;display:flex;align-items:center;gap:1.4cqw;border-bottom:.06cqw solid #b3a3ce77\"><span style=\"font:850 1.2cqw/1.1 system-ui;color:#ffd360;letter-spacing:.17em\">EXPLORE THE REAL THING</span><span style=\"flex:1;border-top:.05cqw solid #9c89b0\"></span><span style=\"font:750 .88cqw system-ui;color:#c5b6df;letter-spacing:.1em\">THREE LIVE DESTINATIONS</span></div>\n<div style=\"position:absolute;left:8.75%;right:7.5%;top:80%;display:flex;justify-content:space-between;align-items:center;gap:2cqw\"><span style=\"font:550 1.35cqw/1.3 Georgia,serif;color:#cfc4e8\">The page tells the story. The graph keeps the structure.</span><div style=\"display:flex;align-items:center;gap:.7cqw\"><span style=\"width:1cqw;height:1cqw;border:.11cqw solid #ffd464;transform:rotate(45deg)\"></span><span style=\"width:1cqw;height:1cqw;border:.11cqw solid #a585e3;transform:rotate(45deg)\"></span><span style=\"width:1cqw;height:1cqw;border:.11cqw solid #6d9fd4;transform:rotate(45deg)\"></span></div></div>\n<div style=\"position:absolute;bottom:3.9%;left:8.75%;right:7.5%;display:flex;align-items:center;justify-content:space-between;border-top:.08cqw solid #8b78aa;padding-top:1.4cqw\"><span style=\"font:850 .96cqw;letter-spacing:.18em;color:#e6d4ff\">TWILITE / CONNECTED WORK, OPEN DESTINATIONS</span><span style=\"font:700 .91cqw;color:#b8a6d5\">A GRAPH-NATIVE WORKSPACE</span></div></div>"
        }
      }
    },
