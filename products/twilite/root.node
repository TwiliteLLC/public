          "direction": "bidirectional",
          "dataType": "any",
          "position": {
            "side": "left",
            "offset": 0.5
          }
        },
        {
          "id": "right",
          "label": "right",
          "direction": "output",
          "dataType": "any",
          "position": {
            "side": "right",
            "offset": 0.5
          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## Proof, Not Just Pitch\n\nTwilite already runs in the browser.\n\nIt already persists graphs.\nIt already exposes them at addresses.\nIt already supports AI-assisted graph authoring.\n\nThis page is itself part of that system.",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1778699490734,
          "reason": "node-drag"
        }
      }
    },
