      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# What Twilite Actually Is\n\nTwilite lets humans and AI build persistent knowledge as navigable graph structures instead of disposable chats and scattered documents.\n\nInstead of losing ideas inside:\n\n- chat history\n- folders\n- tabs\n- whiteboards\n- screenshots\n- disconnected notes\n\nTwilite keeps relationships visible and durable.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "layout",
          "updatedAt": 1778698422220,
          "reason": "auto-layout"
        }
      }
    },
