        "content": {
          "kind": "html",
          "value": "<div style=\"box-sizing:border-box;container-type:inline-size;width:100%;height:100%;overflow:auto;background:#f9f7fc;color:#241b34;padding:6cqw;font-family:system-ui\"><strong style=\"font-size:2cqw;color:#7041a6\">TWILITE</strong><h1 style=\"font:550 7cqw/1.07 Georgia,serif\">Build with your AI.<br>Keep what you create.</h1><p style=\"font:450 2.8cqw/1.45 system-ui\">Turn ideas, plans, and projects into connected graphs you can revisit, change, and share.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1795127943010,
