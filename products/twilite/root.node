        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Why Persistence Matters\n\nMost AI interaction today is disposable.\n\nChats disappear. Context collapses. Ideas fragment. Meaning drifts.\n\nTwilite treats knowledge as something that should accumulate structurally over time. Humans and AI can continue evolving the same graph, the same relationships, and the same semantic terrain.\n\nThe result is durable memory instead of temporary conversation.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1778699709394,
          "reason": "node-drag"
        }
      }
    }
