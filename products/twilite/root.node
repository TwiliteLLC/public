          "type": "value"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# AI Is A First-Class Collaborator\n\nTwilite is designed for humans and AI to work against the same persistent structure.\n\nInstead of generating isolated text blobs, AI can navigate graph structure, inspect relationships, update nodes, create connections, preserve references, and operate through explicit mutation contracts.\n\nThat makes AI collaboration more durable, inspectable, reversible, and graph-native.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "layout",
          "updatedAt": 1778698422220,
          "reason": "auto-layout"
        }
      }
    },
    {
