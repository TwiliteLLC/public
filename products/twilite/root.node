      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Why Graph Structure Matters\n\nMost systems hide relationships.\n\nTwilite exposes them directly.\n\nIdeas are not isolated. They exist in relation to causes, dependencies, references, abstractions, examples, systems, workflows, and people.\n\nA graph preserves those relationships instead of flattening them into linear documents.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "layout",
          "updatedAt": 1778698422220,
          "reason": "auto-layout"
        }
      }
    },
