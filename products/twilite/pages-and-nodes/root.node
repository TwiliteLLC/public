    {
      "id": "pages-and-nodes-detail",
      "type": "face",
      "label": "Pages and Nodes · Reading view",
      "position": {
        "x": -780,
        "y": -700
      },
      "width": 760,
      "height": 470,
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "twilite-pages-and-nodes",
          "nodeId": "pages-and-nodes-detail"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:auto;background:#fbfaf7;color:#203149;padding:6cqw;font-family:system-ui\"><div style=\"font:800 2cqw;letter-spacing:.14em;color:#7356a0\">THE TWILITE ZONE / PAGES AND NODES</div><h1 style=\"font:600 6.6cqw/1.08 Georgia,serif;margin:3cqw 0\">A web page is something you visit.<br/>A node is something you can use.</h1><p style=\"font:430 2.9cqw/1.45 system-ui;max-width:62ch\">A web page is one composed arrangement, read in the order its author chose. A node is a piece with its own identity: a price, a section, a task. A graph is the nodes and the connections between them, saved as one file you own. A page is one face a graph can show: a layout you read top to bottom.</p><p style=\"font:450 2.65cqw/1.43 system-ui;color:#50627a;max-width:62ch\">This explanation is a graph. Open it as a graph to follow the connections, zoom into a piece, and see the real nodes behind the cards.</p></div>"
        }
      }
    },
    {
      "id": "pages-and-nodes-summary",
      "type": "face",
      "label": "Pages and Nodes · Summary",
      "position": {
        "x": 20,
        "y": -700
      },
      "width": 380,
      "height": 235,
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "twilite-pages-and-nodes",
          "nodeId": "pages-and-nodes-summary"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.summary"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:6cqw;background:linear-gradient(145deg,#392f60,#173a58);color:#fff;font-family:system-ui\"><div style=\"font:800 3.6cqw;letter-spacing:.14em;color:#f5c542\">THE TWILITE ZONE / THE WEB, REIMAGINED</div><div style=\"font:600 9cqw/1.09 Georgia,serif;margin-top:5cqw\">Keep the page. Gain the graph.</div><div style=\"font:500 3.8cqw/1.4 system-ui;margin-top:4cqw;color:#dceaff\">Explore spatially. Consume remotely. Reuse by reference.</div></div>"
        }
      }
    },
