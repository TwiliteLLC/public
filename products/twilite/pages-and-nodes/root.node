        "identity": {
          "graphId": "twilite-pages-and-nodes",
          "nodeId": "pages-and-nodes-gain"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:0;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:1.5cqw;padding:3.6cqw;background:linear-gradient(115deg,#1b3c5c,#222b4d);color:white;border:3px solid #85cbe6;border-left:12px solid #85cbe6;border-radius:3cqw;font-family:system-ui\"><div style=\"font:850 2.2cqw/1.15 system-ui;letter-spacing:.13em;color:#85cbe6\">A PAGE IS STILL FINE</div><div style=\"font:650 5.4cqw/1.1 Georgia,serif\">Keep the page. Gain the graph.</div><div style=\"font:470 2.8cqw/1.4 system-ui;color:#edf2fc\">A Twilite graph can publish a page whenever you want one. What you gain is everything behind it: pieces with identity, connections you can follow, and material an AI can work with instead of a flattened page.</div><div style=\"font:760 2cqw/1.3 system-ui;color:#85cbe6;margin-top:1cqw\">THE POINT IS WHAT YOU CAN DO BEHIND THE PAGE</div></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1795112267186,
          "reason": "node-drag"
