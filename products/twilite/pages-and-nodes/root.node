        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:0;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:1.5cqw;padding:3.6cqw;background:linear-gradient(137deg,#3e4052,#273349);color:white;border:3px solid #edc86e;border-left:12px solid #edc86e;border-radius:3cqw;font-family:system-ui\"><div style=\"font:850 2.2cqw/1.15 system-ui;letter-spacing:.13em;color:#edc86e\">01 / ON THE WEB</div><div style=\"font:650 5.6cqw/1.1 Georgia,serif\">Read in order.</div><div style=\"font:470 2.8cqw/1.4 system-ui;color:#edf2fc\">A page runs top to bottom, section by section. Links can take you elsewhere, but the page itself is one composed thing.</div><div style=\"font:760 2cqw/1.3 system-ui;color:#edc86e;margin-top:1cqw\">SCROLL / FOLLOW LINKS</div></div>"
