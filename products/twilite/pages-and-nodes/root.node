        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:0;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:1.5cqw;padding:3.6cqw;background:linear-gradient(132deg,#17506a,#24385b);color:white;border:3px solid #83dbed;border-left:12px solid #83dbed;border-radius:3cqw;font-family:system-ui\"><div style=\"font:850 2.2cqw/1.15 system-ui;letter-spacing:.13em;color:#83dbed\">01 / IN TWILITE</div><div style=\"font:650 5.6cqw/1.1 Georgia,serif\">Go in any direction.</div><div style=\"font:470 2.8cqw/1.4 system-ui;color:#edf2fc\">The same material can be a page, a map of related ideas, or a network of connections. Zoom out for the whole; zoom in for one piece.</div><div style=\"font:760 2cqw/1.3 system-ui;color:#83dbed;margin-top:1cqw\">PAN / ZOOM / FOLLOW EDGES</div></div>"
