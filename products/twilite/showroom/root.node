        "view": {
          "intent": "node",
          "payload": "node.web.environment",
          "fit": "window"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background:radial-gradient(ellipse at 50% 14%,#4c2a77 0%,#212847 48%,#11192d 100%);font-family:system-ui;color:white\"><div style=\"position:absolute;inset:0;opacity:.18;background-image:linear-gradient(90deg,#c5b8f7 1px,transparent 1px),linear-gradient(#c5b8f7 1px,transparent 1px);background-size:7.5cqw 7.5cqw\"></div><div style=\"position:absolute;left:3.5cqw;right:3.5cqw;top:4cqw;border-top:.35cqw solid #f5c542;padding-top:1.8cqw;display:flex;align-items:center;justify-content:space-between\"><strong style=\"font:900 4cqw/.95 system-ui;letter-spacing:.19em;color:#f5c542\">TWILITE</strong><span style=\"font:800 1.8cqw/1.3 system-ui;letter-spacing:.13em;color:#eee2ff\">THE PRODUCT SHOWROOM</span></div><div style=\"position:absolute;top:13cqw;left:4cqw;font:900 1.7cqw system-ui;letter-spacing:.16em;color:#b9a8e2\">YOUR WORK / YOUR AGENT / YOUR SPACE</div><div style=\"position:absolute;top:13cqw;right:4cqw;font:800 1.7cqw system-ui;color:#e5d9fa\">A BETTER WAY TO KEEP BUILDING</div><div style=\"position:absolute;left:3.5cqw;right:3.5cqw;top:46cqw;display:grid;grid-template-columns:repeat(3,1fr);gap:1.7cqw\"><div style=\"height:35cqw;border:1px solid #ab99d4;background:linear-gradient(135deg,#473164ed,#292c55f0);border-radius:1.2cqw;padding:1.6cqw;font:900 2cqw system-ui;letter-spacing:.09em;color:#f5c542\">01 · KEEP</div><div style=\"height:35cqw;border:1px solid #9fa8d7;background:linear-gradient(135deg,#293c61ed,#25365df0);border-radius:1.2cqw;padding:1.6cqw;font:900 2cqw system-ui;letter-spacing:.09em;color:#f5c542\">02 · CONNECT</div><div style=\"height:35cqw;border:1px solid #84bfb8;background:linear-gradient(135deg,#21505ced,#23484af0);border-radius:1.2cqw;padding:1.6cqw;font:900 2cqw system-ui;letter-spacing:.09em;color:#f5c542\">03 · CREATE</div></div><div style=\"position:absolute;left:3.5cqw;right:3.5cqw;top:84cqw;height:6.8cqw;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:2cqw;color:white;background:linear-gradient(90deg,#1b214100,#1b214180,#1b214100);padding:.8cqw 1.2cqw\"><div style=\"display:flex;align-items:baseline;gap:1.5cqw;min-width:0\"><span style=\"font:900 1.45cqw system-ui;letter-spacing:.16em;color:#f5c542;white-space:nowrap\">GO FURTHER</span><span style=\"font:500 3.05cqw/1.1 Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#f5f0ff\">Explore Further</span></div></div><div style=\"position:absolute;left:3.5cqw;right:3.5cqw;top:93cqw;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.7cqw;pointer-events:none\"><div style=\"height:44cqw;box-sizing:border-box;border:1px solid #9989c0a3;border-radius:1.2cqw;background:linear-gradient(160deg,#43305d48,#22294844);padding:1.7cqw\"><div style=\"font:900 1.8cqw system-ui;color:#f5c542;letter-spacing:.11em\">01 / HOW IT WORKS</div></div><div style=\"height:44cqw;box-sizing:border-box;border:1px solid #98a9d0a3;border-radius:1.2cqw;background:linear-gradient(160deg,#2e3d5c55,#22294844);padding:1.7cqw\"><div style=\"font:900 1.8cqw system-ui;color:#f5c542;letter-spacing:.11em\">02 / WHERE IT LEADS</div></div><div style=\"height:44cqw;box-sizing:border-box;border:1px solid #8db7b5a3;border-radius:1.2cqw;background:linear-gradient(160deg,#234b5355,#22294844);padding:1.7cqw\"><div style=\"font:900 1.8cqw system-ui;color:#f5c542;letter-spacing:.11em\">03 / HOW TO BEGIN</div></div></div><div style=\"position:absolute;left:3.5cqw;right:3.5cqw;top:145cqw;border-top:.15cqw solid #8c7da7;display:flex;justify-content:space-between;align-items:center;padding-top:1.4cqw\"><span style=\"font:900 1.75cqw system-ui;color:#f5c542;letter-spacing:.13em\">BEHIND THE SHOWROOM</span><span style=\"font:600 1.45cqw system-ui;color:#cfc2e7\">SOURCE NOTES &amp; WORKROOM</span></div><div style=\"position:absolute;left:3.5cqw;right:3.5cqw;bottom:3cqw;display:flex;justify-content:space-between;gap:1cqw;align-items:center;font:900 1.7cqw system-ui;letter-spacing:.08em;color:#e6d8fb\"><span>EXPLORE FREE</span><span>EDITOR · 14 DAYS FREE, THEN $20 / MONTH</span><span>BRING YOUR OWN AI</span></div></div>"
        },
