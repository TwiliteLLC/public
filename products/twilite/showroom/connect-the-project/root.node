          "value": "<div style=\"box-sizing:border-box;width:100%;height:100%;container-type:inline-size;overflow:hidden;background:#172e50;color:#f9fbff;border:3px solid #9db7df;border-radius:22px;padding:3.2cqw;font-family:system-ui;display:flex;flex-direction:column;justify-content:space-between\"><div><div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;font:900 3.2cqw/1.1 system-ui;letter-spacing:.14em;color:#f5c542\"><span>THE PLAN</span><span style=\"font:750 2.0cqw/1.2 system-ui;letter-spacing:.08em;color:#9db7df\">A WAY FORWARD</span></div><h2 style=\"font:650 8.1cqw/1.04 Georgia,serif;letter-spacing:-.025em;margin:2.5cqw 0 2.0cqw;color:#fff\">Make the first visit useful</h2><p style=\"font:480 4.6cqw/1.32 system-ui;color:#e5f0ff;margin:0\">Give a newcomer a working starting point: a graph, a template, and an agent-friendly path from conversation to something worth keeping.</p></div><div style=\"height:3px;min-height:3px;flex-shrink:0;background:linear-gradient(90deg,#9db7df,transparent);opacity:.7;margin-top:1.7cqw\"></div></div>"
