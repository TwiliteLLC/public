        "content": {
          "kind": "html",
          "value": "<div style=\"box-sizing:border-box;width:100%;height:100%;container-type:inline-size;overflow:hidden;background:#17413f;color:#f9fbff;border:3px solid #a0d6cc;border-radius:22px;padding:3.2cqw;font-family:system-ui;display:flex;flex-direction:column;justify-content:space-between\"><div><div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;font:900 3.2cqw/1.1 system-ui;letter-spacing:.14em;color:#f5c542\"><span>THE DECISION</span><span style=\"font:750 2.0cqw/1.2 system-ui;letter-spacing:.08em;color:#a0d6cc\">A CHOSEN DIRECTION</span></div><h2 style=\"font:650 8.1cqw/1.04 Georgia,serif;letter-spacing:-.025em;margin:2.5cqw 0 2.0cqw;color:#fff\">Build a workspace, not a chatbot</h2><p style=\"font:480 4.6cqw/1.32 system-ui;color:#e5f0ff;margin:0\">Keep the graph document as the durable artifact. An AI is a collaborator that can create and revise it; the workspace isn't tied to one conversation.</p></div><div style=\"height:3px;min-height:3px;flex-shrink:0;background:linear-gradient(90deg,#a0d6cc,transparent);opacity:.7;margin-top:1.7cqw\"></div></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1795020557575,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "showroom-connect-the-project-question",
      "type": "content",
      "label": "QUESTION · The first ten minutes",
      "position": {
