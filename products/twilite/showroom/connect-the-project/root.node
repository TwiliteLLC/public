        "content": {
          "kind": "html",
          "value": "<div style=\"position:relative;box-sizing:border-box;width:100%;height:100%;container-type:inline-size;overflow:hidden;background:radial-gradient(ellipse at 35% 9%,#345b87,#172948 55%,#101b31);color:#fff;font-family:system-ui\"><div style=\"position:absolute;inset:0;opacity:.14;background-image:linear-gradient(90deg,#bbd2ff 1px,transparent 1px),linear-gradient(#bbd2ff 1px,transparent 1px);background-size:8cqw 8cqw\"></div><div style=\"position:absolute;left:4cqw;right:4cqw;top:4cqw;border-top:.4cqw solid #f5c542;padding-top:2cqw;display:flex;justify-content:space-between;font:900 1.8cqw system-ui;letter-spacing:.14em;color:#f5c542\"><span>TWILITE / CONNECT</span><span>GUIDED PROJECT TOUR</span></div><div style=\"position:absolute;left:4cqw;top:12cqw;font:500 8.2cqw/1.1 Georgia,serif\">See the whole project.<br/>Follow any thread.</div><div style=\"position:absolute;left:4cqw;top:34cqw;font:500 2.4cqw system-ui;color:#d6e7ff\">One goal. Many connected decisions. Real destinations.</div><div style=\"position:absolute;left:4cqw;right:4cqw;top:45cqw;border-top:.2cqw solid #91acce\"></div><div style=\"position:absolute;left:4cqw;top:49cqw;font:900 1.8cqw system-ui;color:#f5c542;letter-spacing:.14em\">THE GOAL</div><div style=\"position:absolute;left:4cqw;right:4cqw;top:71cqw;display:grid;grid-template-columns:repeat(3,1fr);gap:2cqw\"><div style=\"height:42cqw;border:1px solid #93acd1;border-radius:2cqw;background:#2b487350;padding:2cqw;font:900 2cqw system-ui;color:#f5c542\">PLAN</div><div style=\"height:42cqw;border:1px solid #93acd1;border-radius:2cqw;background:#45346b50;padding:2cqw;font:900 2cqw system-ui;color:#f5c542\">DECISION</div><div style=\"height:42cqw;border:1px solid #93acd1;border-radius:2cqw;background:#2c555950;padding:2cqw;font:900 2cqw system-ui;color:#f5c542\">QUESTION</div></div><div style=\"position:absolute;left:4cqw;top:121cqw;font:900 1.75cqw system-ui;letter-spacing:.12em;color:#f5c542\">OPEN THE ACTUAL GRAPHS</div><div style=\"position:absolute;left:4cqw;right:4cqw;bottom:4cqw;border-top:.2cqw solid #9baed0;padding-top:2cqw;font:700 1.65cqw system-ui;color:#dfe9fb\">PROGRESS IS MORE THAN A LIST OF LINKS</div></div>"
        }
