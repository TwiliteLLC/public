          "value": "<div style=\"box-sizing:border-box;background:linear-gradient(145deg,#283967,#152b46);color:#fff;width:100%;height:100%;padding:6cqw;container-type:inline-size;font-family:system-ui\"><div style=\"font:900 4cqw system-ui;letter-spacing:.12em;color:#f5c542\">CONNECT</div><div style=\"font:650 11cqw/1.07 Georgia,serif;margin:6cqw 0\">One project.<br/>Every part.</div><div style=\"font:500 4cqw/1.4 system-ui;color:#d8e8fc\">See the whole. Follow the work.</div></div>"
        }
      }
