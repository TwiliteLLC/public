        "content": {
          "kind": "html",
          "value": "<div style=\"box-sizing:border-box;width:100%;height:100%;container-type:inline-size;overflow:hidden;background:#35264f;color:#f9fbff;border:3px solid #c9a3ec;border-radius:22px;padding:3.2cqw;font-family:system-ui;display:flex;flex-direction:column;justify-content:space-between\"><div><div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;font:900 3.2cqw/1.1 system-ui;letter-spacing:.14em;color:#f5c542\"><span>THE GOAL</span><span style=\"font:750 2.0cqw/1.2 system-ui;letter-spacing:.08em;color:#c9a3ec\">A SHARED DIRECTION</span></div><h2 style=\"font:650 8.1cqw/1.04 Georgia,serif;letter-spacing:-.025em;margin:2.5cqw 0 2.0cqw;color:#fff\">Open Twilite to builders</h2><p style=\"font:480 4.6cqw/1.32 system-ui;color:#e5f0ff;margin:0\">Let people and their AI create durable, reusable, connected work. A product launch is the outcome, not the entirety of the project.</p></div><div style=\"height:3px;min-height:3px;flex-shrink:0;background:linear-gradient(90deg,#c9a3ec,transparent);opacity:.7;margin-top:1.7cqw\"></div></div>"
