          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background:#142d39;color:#e9f7f2;font-family:system-ui;padding:5cqw\"><div style=\"font:800 2.1cqw/1.2 system-ui;letter-spacing:.16em;color:#f0c17f\">TWILITE / USER EXERCISE</div><h1 style=\"font:600 6cqw/1.05 Georgia,serif;margin:2.5cqw 0\">Give your AI a job. Watch it follow the graph.</h1><p style=\"font:2.5cqw/1.5 system-ui;color:#c5e0dc;margin:0\">Read a stockroom snapshot, work out what to reorder, prove the answer, and ask you before it hands anything back.</p><p style=\"font:2cqw/1.4 system-ui;color:#e9b96d;margin:2.5cqw 0 0\">No accounts · No purchases · Nothing saved</p></div>"
