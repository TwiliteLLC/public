    {
      "id": "rnw-stage-06",
      "type": "page-section",
      "label": "06 · Owner approves publication",
      "position": {
        "x": -830,
        "y": 401
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "06 · Owner approves publication",
        "body": "Show the owner the rendered draft, the release id, each entry’s verification line and the digest. Approval is one fresh message naming the release: publish <releaseId>. It covers that draft as shown and nothing else. If the draft changes, the digest no longer matches and the approval is void.\n\n**Who:** The owner decides.\n**What is checked:** The owner says publish <releaseId>; Digest unchanged since it was shown; Not an entry approval or an earlier message.\n**If it fails:** Stop. Never infer approval.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-06"
        },
