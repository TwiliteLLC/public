    {
      "id": "rnw-stage-08",
      "type": "page-section",
      "label": "08 · Close out the queue and check the site",
      "position": {
        "x": 450,
        "y": 401
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "08 · Close out the queue and check the site",
        "body": "After the owner has published the repository: mark the release’s entries published with releasedIn, add the release id, time and approved digest to the queue’s publishedReleases, and move the entries into their archive graph. Then fetch the hosted release and hub and confirm the date, the entries, and that the release appears once, newest first.\n\n**Who:** It writes only after the owner has approved the release.\n**Left behind:** Entries marked published, archive written, hosted pages fetched and matching.\n**If it fails:** Stop. It can be run again; it skips what is already done.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-08"
