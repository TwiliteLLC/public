    {
      "id": "rnw-never",
      "type": "page-section",
      "label": "What never happens",
      "position": {
        "x": -830,
        "y": 781
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "What never happens",
        "body": "- A release is never published because an entry was approved, a commit was made or a timer ran.\n- Private review notes, review records and source commits never go into a public release.\n- A published release is never edited or deleted.\n- An approval covers the release exactly as it was shown. If the release changes, the approval is void.\n- An agent never infers the owner’s approval, and never publishes the site on the owner’s behalf.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-never"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
