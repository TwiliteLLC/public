    {
      "id": "rnw-stage-04",
      "type": "page-section",
      "label": "04 · Assemble a private draft",
      "position": {
        "x": 450,
        "y": 21
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "04 · Assemble a private draft",
        "body": "Make a draft release graph from the Release Graph template, holding a copy of each approved entry’s public fields. Never copy review notes, review records or source commits into it. Show the owner the page and give its content digest (SHA-256 of the public content).\n\n**Who:** It writes private drafts only. Nothing public.\n**Left behind:** Entry count, ids, the digest, and that no private fields were copied.\n**If it fails:** Stop, record why, and tell the owner. Do not continue past a failed step.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-04"
        },
