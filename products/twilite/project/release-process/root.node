    {
      "id": "rnw-about",
      "type": "page-section",
      "label": "What this is",
      "position": {
        "x": 450,
        "y": -359
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "What this is",
        "body": "A release of Twilite is not a thing that happens to the site. It is made, step by step, from changes that have been reviewed, checked on the live site and approved by the owner.\n\nThe work is split on purpose. **An agent can do the reading, the drafting and the checking.** **The owner makes three decisions:** which entries are approved (stage 03), that the release is ready to publish (stage 06), and publishing the site itself. Nothing here gives an agent those decisions, and nothing starts on a timer, a commit or an approved entry.\n\nWhat a release says is fixed once it is public. It is never edited or deleted. A mistake is corrected by a new release that says what it replaces.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-about"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
