    {
      "id": "rnw-stage-03",
      "type": "page-section",
      "label": "03 · Owner approves entries",
      "position": {
        "x": -190,
        "y": 21
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "03 · Owner approves entries",
        "body": "The owner reads each candidate and sets its status in the queue: approved, deferred or excluded. Only approved entries go into the draft. A candidate’s wording is checked for review or deployment sentences that must not be published.\n\n**Who:** The owner decides.\n**What is checked:** Each entry’s status in the queue; The owner’s own edits kept; No review wording inside a summary.\n**If it fails:** Stop. Entries that are not approved stay in the queue.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-03"
        },
