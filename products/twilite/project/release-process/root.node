    {
      "id": "rnw-stage-02",
      "type": "page-section",
      "label": "02 · Review new commits",
      "position": {
        "x": -830,
        "y": 21
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "02 · Review new commits",
        "body": "Read the commits made since each watched repository’s checkpoint (the app and the canon library). Turn user-visible changes into Release Entry candidates in the review queue; leave out publication machinery, internal builders, copy-only changes and maintenance. Compare against earlier public releases and archives so nothing is repeated. Keep the owner’s edits and update the checkpoints.\n\n**Who:** It writes private drafts only. Nothing public.\n**Left behind:** Commit ranges read, candidates added, entries left out and why.\n**If it fails:** Stop, record why, and tell the owner. Do not continue past a failed step.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-02"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
