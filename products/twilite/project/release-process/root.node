    {
      "id": "rnw-stage-09",
      "type": "page-section",
      "label": "09 · Record the run",
      "position": {
        "x": 1090,
        "y": 401
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "09 · Record the run",
        "body": "Write an append-only run record in the review queue’s journal: run id, release id, steps and gates with outcomes, verification evidence, the approved digest, output references, errors, and start and end times. Do it even when the run stopped early or a gate failed.\n\n**Who:** It only records what happened.\n**Left behind:** Run id, release id, outcomes, digest, and any stop reason.\n**If it fails:** Tell the owner the run could not be recorded.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-09"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
