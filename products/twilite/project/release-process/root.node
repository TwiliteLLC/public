    {
      "id": "rnw-stage-05",
      "type": "page-section",
      "label": "05 · Verify each entry is live",
      "position": {
        "x": 1090,
        "y": 21
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "05 · Verify each entry is live",
        "body": "Check again at publish time; an earlier verified is not trusted. For a change to the app, its commits are in what the live site runs (X-Twilite-Commit). For a change to the canon library, the changed file is fetched from the hosted library. Then one behaviour check by the owner or an agent on the live site, recorded with the entry. Entry ids are unique.\n\n**Who:** It only reads.\n**What is checked:** Live commit and each entry’s commits; Fetched canon file for library changes; Behaviour check noted for each entry.\n**If it fails:** Stop and record which entries failed. Fix, redeploy or defer them, then start again from step 04.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-05"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
