        },
        "title": "At a glance",
        "rows": [
          {
            "label": "Status",
            "value": "In use. This is the process behind every release note."
          },
          {
            "label": "Starts only when",
            "value": "the owner names a release"
          },
          {
            "label": "Owner decisions",
            "value": "three: which entries are approved, that the release is ready, and publishing the site"
          },
          {
            "label": "Unpublish",
            "value": "Never. A mistake is corrected by a new release."
