    {
      "id": "rnw-stage-01",
      "type": "page-section",
      "label": "01 · Owner names a release",
      "position": {
        "x": 1090,
        "y": -359
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "title": "01 · Owner names a release",
        "body": "The owner asks for a release by name or date. It never starts from a commit, a timer or an approved entry. Confirm the release id (YYYY-MM-DD, with -2 for a second release in a day) and that no public release with that id exists yet.\n\n**Who:** It only reads.\n**Left behind:** The owner’s message and the release id.\n**If it fails:** Stop, record why, and tell the owner. Do not continue past a failed step.",
        "identity": {
          "graphId": "release-process",
          "nodeId": "rnw-stage-01"
        },
