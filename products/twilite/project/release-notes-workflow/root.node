      "data": {
        "title": "Run records",
        "eyebrow": "EXECUTION HISTORY",
        "body": "Each run is recorded in the review queue’s journal beside publishedReleases: run id, release id, per-step outcomes, verification evidence, gate decisions, errors, the approved digest, output references, and start and end times. A run that stops early or fails a gate is recorded too; recording does not wait for the success path.",
        "note": "The journal is private. Nothing in it is published.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "FileText"
          }
        },
        "identity": {
