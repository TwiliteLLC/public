    {
      "id": "twilite-release-notes-workflow-policy",
      "type": "workflow-info-card",
      "label": "Domain rules",
      "position": {
        "x": 739.7213345148837,
        "y": 373.87634061748366
      },
      "width": 710,
      "height": 355,
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Permission boundary",
        "eyebrow": "PERMISSION BOUNDARY",
        "body": "• Entries move only by the owner’s hand: an approved entry may enter a private draft, and grants no right to publish.\n• Never copy review notes, review records or source commits into public release entries.\n• Publishing is two separate yeses: the owner’s “publish <releaseId>” against the digest (step 06), then the owner’s own commit, push and publish of the Twilite LLC repository.\n• A published release is never edited or deleted. A mistake is corrected by a new release.\n• Each step checks whether its work is already done, so a stopped run can be started again.",
        "note": "Public writes are create-only and follow gate 06.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "ShieldCheck"
          }
        },
        "identity": {
          "graphId": "twilite-release-notes-workflow",
          "nodeId": "twilite-release-notes-workflow-policy"
        },
        "classRef": "tlz://twilite.zone/library/templates/repeatable-workflow/classes/workflow-info-card.node-class.node",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1795557694724,
          "reason": "node-drag"
        }
      }
    },
    {
