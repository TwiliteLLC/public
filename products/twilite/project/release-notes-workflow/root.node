      "data": {
        "title": "08 · Close out the queue and check the site",
        "phase": "journal",
        "instruction": "After the owner has published the repository: mark the release’s entries published with releasedIn, add the release id, time and approved digest to the queue’s publishedReleases, and move the entries into their archive graph. Then fetch the hosted release and hub and confirm the date, the entries, and that the release appears once, newest first.",
        "inputs": "publishedReleaseRef digest",
        "outputs": "archive hostedCheck",
        "authority": "approved-write",
        "onFailure": "Stop. It can be run again; it skips what is already done.",
