        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#faf7ff;padding:4cqw;box-sizing:border-box;font-family:system-ui'><div style='font:700 1.4cqw ui-monospace,monospace;letter-spacing:.2em;color:#6d28d9'>TWILITE / RELEASE NOTES</div><h1 style='font:700 5cqw Georgia,serif;color:#1f2937;margin:2cqw 0'>Release notes</h1><p style='font:400 2cqw/1.5 Georgia,serif;color:#64748b'>Every published Twilite release, newest first.</p><div style='display:grid;grid-template-columns:repeat(auto-fit,minmax(25cqw,1fr));gap:2cqw;margin-top:3cqw'><a href='tlz://twilite.zone/products/twilite/release-notes/2026/2026-11-21/root.node' style='display:block;padding:2.4cqw;border:1px solid #ddd6fe;border-radius:2cqw;background:#faf7ff;text-decoration:none;color:#1f2937'><div style='font:700 3cqw Georgia,serif'>21 November 2026</div><div style='font:500 1.6cqw system-ui;color:#6d28d9;margin-top:1cqw'>Open release →</div></a><a href='tlz://twilite.zone/products/twilite/release-notes/2026/2026-11-13/root.node' style='display:block;padding:2.4cqw;border:1px solid #ddd6fe;border-radius:2cqw;background:#faf7ff;text-decoration:none;color:#1f2937'><div style='font:700 3cqw Georgia,serif'>13 November 2026</div><div style='font:500 1.6cqw system-ui;color:#6d28d9;margin-top:1cqw'>Open release →</div></a></div></div>"
