    {
      "id": "releases-hub-detail",
      "type": "face",
      "label": "Latest release · 22 November 2026",
      "position": {
        "x": -640,
        "y": 240
      },
      "width": 600,
      "height": 400,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "releases-hub"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#faf7ff;font-family:Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'><div style='padding:1.4cqw 0;border-top:.4cqw solid #1f2937;border-bottom:.1cqw solid #1f2937;display:flex;justify-content:space-between;font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#6d28d9'><span>Release notes</span><span style='color:#b45309'>22 November 2026</span></div><div style='font:700 5.4cqw/1.1 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:3cqw 0 .8cqw;color:#1f2937'>Release notes: 22 November 2026</div><div style='font:400 2.2cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:2cqw;max-width:62cqw'>Choose how workspace connections are drawn, and public pages that open without a GitHub sign-in.</div><div style='display:flex;justify-content:space-between;align-items:baseline;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'><span style='font:700 1.5cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1d4ed8'>Changed</span><span style='font:600 1.4cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 change</span></div><div style='margin-bottom:2.4cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e9e5f5;border-left:.7cqw solid #1d4ed8'><div style='font:700 2.2cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Choose how workspace connections are drawn</div><div style='font:400 1.75cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.6cqw'>Workspace connections now offer Orthogonal, Curved and Straight drawing modes. Orthogonal routes use rounded corners, Curved draws a simple S-curve, and the view updates when you switch modes.</div></div><div style='display:flex;justify-content:space-between;align-items:baseline;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'><span style='font:700 1.5cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#b45309'>Fixed</span><span style='font:600 1.4cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 change</span></div><div style='margin-bottom:2.4cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e9e5f5;border-left:.7cqw solid #b45309'><div style='font:700 2.2cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Public pages open without a GitHub sign-in</div><div style='font:400 1.75cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.6cqw'>The Why Twilite pages, Blusheree, the Twilite project page and the release notes are now served from twilite.zone, so anyone can open them without signing in to GitHub.</div></div></div></div>"
        },
        "memo": "The Detail: the newest release as a page of notes. It is copied from that release each time the hub is made, so edit the release and not this.",
        "link": ""
      }
    },
