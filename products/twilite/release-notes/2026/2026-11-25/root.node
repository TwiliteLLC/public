        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "release-2026-11-25"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#faf7ff;font-family:Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'><div style='padding:1.4cqw 0;border-top:.4cqw solid #1f2937;border-bottom:.1cqw solid #1f2937;display:flex;justify-content:space-between;font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#6d28d9'><span>Release notes</span><span style='color:#b45309'>25 November 2026</span></div><div style='font:700 5.4cqw/1.1 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:3cqw 0 .8cqw;color:#1f2937'>Release notes: 25 November 2026</div><div style='font:400 2.2cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:2cqw;max-width:62cqw'>Question-driven workflow templates, consistent resizing, and direct dragging for live class cards.</div><div style='margin-top:3cqw'><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#b45309;margin-bottom:1.2cqw'>Highlights</div><div style='font:600 1.9cqw/1.5 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#1f2937;margin-top:.5cqw'><span style='color:#b45309'>◆</span> Create repeatable workflows with an explicit Question</div></div><div style='display:flex;justify-content:space-between;align-items:baseline;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'><span style='font:700 1.5cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#15803d'>New</span><span style='font:600 1.4cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 change</span></div><div style='margin-bottom:2.4cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e9e5f5;border-left:.7cqw solid #15803d'><div style='font:700 2.2cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Create repeatable workflows with an explicit Question</div><div style='font:400 1.75cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.6cqw'>The library now includes a Repeatable Workflow template with ordered Steps and approval Gates. A first-class Question defines the answer format, required evidence and completion criteria, while a read-only preflight checks the workflow structure before an agent follows it.</div></div><div style='display:flex;justify-content:space-between;align-items:baseline;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'><span style='font:700 1.5cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1d4ed8'>Changed</span><span style='font:600 1.4cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>2 changes</span></div><div style='margin-bottom:2.4cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e9e5f5;border-left:.7cqw solid #1d4ed8'><div style='font:700 2.2cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Resize nodes more consistently across zoom levels</div><div style='font:400 1.75cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.6cqw'>Node resize handles now use a consistent rule across node types and card views. Handles appear when hovering in editing mode or using Alt while browsing, and adjust to the node&#39;s displayed size so small cards aren&#39;t obscured.</div></div><div style='margin-bottom:2.4cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e9e5f5;border-left:.7cqw solid #1d4ed8'><div style='font:700 2.2cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Drag live class cards directly by their bodies</div><div style='font:400 1.75cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.6cqw'>When a class card is focused, its non-interactive surface can now be dragged to move the node. Buttons, links, fields and scrollbars keep their own interactions, and drag coordinates account for the frame&#39;s displayed scale.</div></div></div></div>"
        },
        "memo": "The Detail: the release as a page of notes, from its entries. The Method writes it, so edit the entries and not this.",
        "link": "",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793398054115,
          "reason": "node-drag"
        }
      }
    },
