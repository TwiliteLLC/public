        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:6cqw 7cqw 5cqw;border-radius:6cqw;background:#faf7ff;border:.9cqw solid #6d28d9;border-top:2.4cqw solid #f5c542;color:#1f2937;overflow:hidden;display:flex;flex-direction:column;gap:3cqw'><div style='display:flex;justify-content:space-between;gap:2cqw;font:700 3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9;white-space:nowrap'><span>Release notes</span><span style='color:#b45309'>25 Nov 2026</span></div><div style='display:flex;gap:3cqw;flex:1;min-height:0'><div style='flex:1;min-width:0;text-align:center;border-top:1cqw solid #15803d;padding-top:1.6cqw'><div style='font:700 17cqw/1 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#15803d'>1</div><div style='font:700 3.4cqw/1.2 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#15803d;margin-top:1cqw'>New</div></div><div style='flex:1;min-width:0;text-align:center;border-top:1cqw solid #1d4ed8;padding-top:1.6cqw'><div style='font:700 17cqw/1 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1d4ed8'>2</div><div style='font:700 3.4cqw/1.2 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#1d4ed8;margin-top:1cqw'>Changed</div></div><div style='flex:1;min-width:0;text-align:center;border-top:1cqw solid #cbd5e1;padding-top:1.6cqw'><div style='font:700 17cqw/1 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#cbd5e1'>0</div><div style='font:700 3.4cqw/1.2 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:1cqw'>Fixed</div></div></div><div style='font:500 3.4cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><span style='color:#b45309'>◆</span> Create repeatable workflows with an explicit Question</div></div></div>"
